{
  "name": "@avi/core",
  "version": "0.0.0",
  "private": true,
  "description": "Avi.js public API: application factory, modules and controllers.",
  "keywords": [
    "avi",
    "avi.js",
    "framework",
    "http",
    "dependency-injection",
    "decorators",
    "typescript"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://github.com/chrischase011/avi-js#readme",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "@avi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avi/di": "workspace:*",
    "@avi/http": "workspace:*",
    "@avi/validation": "workspace:*"
  },
  "devDependencies": {
    "valibot": "1.5.0"
  }
}
