{
  "name": "@avijs/di",
  "version": "0.2.1",
  "description": "Explicit, reflection-free dependency injection for Avi.js.",
  "keywords": [
    "avi",
    "avi.js",
    "dependency-injection",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://chrischase011.github.io/avi-js/",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/di"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
