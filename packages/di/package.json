{
  "name": "@avi/di",
  "version": "0.0.0",
  "private": true,
  "description": "Explicit, reflection-free dependency injection for Avi.js.",
  "keywords": [
    "avi",
    "avi.js",
    "dependency-injection",
    "ioc",
    "typescript"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://github.com/chrischase011/avi-js#readme",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/di"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  }
}
