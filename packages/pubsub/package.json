{
  "name": "@avijs/pubsub",
  "version": "1.1.1-rc.0",
  "description": "Typed pub/sub for Avi.js: in memory, across cluster() workers, or through Redis.",
  "keywords": [
    "avi",
    "avi.js",
    "pubsub",
    "sse",
    "redis",
    "cluster"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://chrischase011.github.io/avi-js/",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/pubsub"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avijs/core": "workspace:^"
  },
  "devDependencies": {
    "@avijs/workers": "workspace:^"
  }
}
