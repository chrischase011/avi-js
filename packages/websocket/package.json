{
  "name": "@avijs/websocket",
  "version": "1.2.0-rc.0",
  "description": "WebSocket routes for Avi.js, with guards, dependency injection and typed messages.",
  "keywords": [
    "avi",
    "avi.js",
    "websocket",
    "ws",
    "realtime"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://chrischase011.github.io/avi-js/",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/websocket"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avijs/core": "workspace:^",
    "@types/ws": "^8.18.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@avijs/pubsub": "workspace:^",
    "@avijs/testing": "workspace:^",
    "valibot": "1.5.0"
  }
}
