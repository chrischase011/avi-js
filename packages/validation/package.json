{
  "name": "@avijs/validation",
  "version": "0.5.3",
  "description": "Standard Schema validation for Avi.js routes.",
  "keywords": [
    "avi",
    "avi.js",
    "validation",
    "standard-schema"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://chrischase011.github.io/avi-js/",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/validation"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avijs/http": "workspace:*"
  },
  "devDependencies": {
    "valibot": "1.5.0"
  }
}
