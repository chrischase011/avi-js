      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avi/core": "workspace:*"
  },
  "devDependencies": {
    "valibot": "1.5.0"
  }
}
