{
  "name": "@avi/openapi",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI 3.1 documents for Avi.js apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/openapi"
  },
  "engines": {
    "node": ">=22.12"
  },
