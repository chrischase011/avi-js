{
  "name": "@avi/compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Optional build-time checks and manifests for Avi.js apps.",
  "keywords": [
    "avi",
    "avi.js",
    "compiler",
    "typescript",
    "manifest"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://github.com/chrischase011/avi-js#readme",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/compiler"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "bin": {
    "avi-compile": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@avi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avi/core": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.8"
  }
}
