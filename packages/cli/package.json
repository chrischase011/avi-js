{
  "name": "@avi/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The avi command: project scaffolding, dev mode and build checks.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "@avi/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avi/compiler": "workspace:*"
  },
  "bin": {
    "avi": "./dist/bin.js"
  },
  "peerDependencies": {
    "typescript": ">=5.8"
  }
}
