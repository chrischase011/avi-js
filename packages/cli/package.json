{
  "name": "@avijs/cli",
  "version": "1.0.0-rc.5",
  "description": "The avi command: project scaffolding, dev mode and build checks.",
  "keywords": [
    "avi",
    "avi.js",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "author": "Christopher Robin Chase",
  "homepage": "https://chrischase011.github.io/avi-js/",
  "bugs": {
    "url": "https://github.com/chrischase011/avi-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischase011/avi-js.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "bin": {
    "avi": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "@avijs/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@avijs/compiler": "workspace:^"
  },
  "peerDependencies": {
    "typescript": ">=5.8"
  },
  "devDependencies": {
    "valibot": "1.5.0",
    "zod": "4.6.7"
  }
}
