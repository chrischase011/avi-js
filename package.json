{
  "name": "avi-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:router": "pnpm build && pnpm --filter @avijs/benchmarks router",
    "bench:http": "pnpm build && pnpm --filter @avijs/benchmarks http",
    "bench:startup": "pnpm build && pnpm --filter @avijs/benchmarks startup",
    "avi": "node packages/cli/dist/bin.js",
    "examples": "pnpm --filter \"./examples/*\" smoke",
    "release:version": "node scripts/set-version.mjs",
    "verify:artifacts": "pnpm build && node scripts/verify-artifacts.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm examples",
    "bench:profile": "pnpm build && pnpm --filter @avijs/benchmarks profile",
    "bench:baseline": "pnpm build && pnpm --filter @avijs/benchmarks baseline",
    "bench:inproc": "pnpm build && pnpm --filter @avijs/benchmarks inproc"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
